# Optional. The Vite client defaults to http://127.0.0.1:8000.
VITE_LOCAL_API_BASE=http://127.0.0.1:8000

# Durable persistence for advisor.server (never expose these to Vite).
# local (default) = config/profiles + data/* on disk
# supabase = Postgres tables public.profiles / public.datasets / public.blobs
# DATA_STORE wins over PROFILE_STORE when both set.
DATA_STORE=supabase
PROFILE_STORE=supabase
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
